PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/trace_db?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_BASE_URL=https://api.crossref.org
CORE_BASE_URL=https://api.core.ac.uk

# TRACE profile: minimum | standard
TRACE_PROFILE=minimum

# AI (OpenAI-compatible HTTP adapter)
AI_PROVIDER=openai_compatible
AI_MODEL=mistral-small-latest
AI_API_KEY=
AI_BASE_URL=https://api.mistral.ai/v1
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
TRACE_MAX_LLM_CALLS=24

# Optional per-agent output token overrides (see traceProfile.js)
# TRACE_MAX_OUTPUT_TOKENS_PLANNER=1536

# Explorer bounding limits (profile caps apply when TRACE_PROFILE=minimum)
EXPLORER_MAX_SEARCH_QUERIES=7
EXPLORER_MAX_RESULTS_PER_QUERY=10
EXPLORER_MAX_TOTAL_PAPERS=50
EXPLORER_MAX_GRAPHRAG_CALLS=7
EXPLORER_MAX_REFINED_QUERIES=2

# GROBID full-text extraction
GROBID_BASE_URL=http://localhost:8070
GROBID_TIMEOUT_MS=120000
FULL_TEXT_GROBID_TIMEOUT_MS=180000
FULL_TEXT_GROBID_PAPER_DEADLINE_MS=240000

# Full-text acquisition (bounded parallel paper workers; GROBID stays serial)
FULL_TEXT_CONCURRENCY=3
UNPAYWALL_EMAIL=you@example.com
